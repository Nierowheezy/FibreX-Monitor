# FibreX Monitor – environment variables
#
# Nothing here is required. Without any of these the app runs and monitors
# normally; the router integration simply stays off, and every router card
# says so honestly.

# ----- Speed test ------------------------------------------------------------
# The speed test needs no configuration: it measures against
# speed.cloudflare.com and shows that host on the screen.

# ----- Router (optional, read-only) -------------------------------------------
# The normal way to connect the router is inside the app: Settings →
# Router connection, where the password goes to the Keychain. These variables
# exist for shell-driven testing; a complete pair on the environment wins over
# what is stored in the app's settings, while it is present.
#
# There is no default password and nothing is ever compiled in.
# When no credentials come from either place the app reports
# "router integration unavailable" rather than guessing.

# Router address. Defaults to 192.168.100.1 when unset.
FIBREX_ROUTER_HOST=192.168.100.1

# Router port. The observed firmware serves its UI on HTTP port 80 (its HTTPS
# port 443 is closed), so this is also the default.
FIBREX_ROUTER_PORT=80

# Sign-in user name exactly as the router's web login accepts it.
FIBREX_ROUTER_USERNAME=admin

# Sign-in password. Read-only the moment it is used: the app only logs in to
# read pages and never changes any router setting.
FIBREX_ROUTER_PASSWORD=change-me
